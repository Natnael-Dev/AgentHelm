# ─── AGENTGUARD LIVE ENVIRONMENT CONFIGURATION ───────────────────────────────

# Environment Mode: development | production | test
AGENTGUARD_ENV=development

# Unix Domain Socket Path (IPC between Go Daemon and Rust Telemetry Engine)
AGENTGUARD_SOCK=/tmp/agentguard.sock

# Sandboxed Git Worktree Root Directory
AGENTGUARD_WORKSPACE=./workspace

# Rust Telemetry WebSocket Server Binding Address
WS_BIND_ADDR=0.0.0.0:8765

# Rust Log Level: trace | debug | info | warn | error
RUST_LOG=info

# Node.js Exeora MCP Tunnel Configuration
PORT=9000
HOST=127.0.0.1
AGENTGUARD_MCP_SECRET=your_secure_random_secret_here

# Frontend Vite Dev Server Port
VITE_PORT=5173
